{
  "version": 2,
  "framework": null,
  "installCommand": "npm install --omit=dev --ignore-scripts",
  "buildCommand": "node scripts/vercel-static-build.mjs",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/home/", "destination": "/", "permanent": true },
    { "source": "/about-contact", "destination": "/contact-us", "permanent": true },
    { "source": "/about-contact/", "destination": "/contact-us", "permanent": true },
    { "source": "/contact", "destination": "/contact-us", "permanent": true },
    { "source": "/contact/", "destination": "/contact-us", "permanent": true },
    { "source": "/store", "destination": "/toolkit", "permanent": false },
    { "source": "/store/", "destination": "/toolkit", "permanent": false },
    { "source": "/store-public.html", "destination": "/toolkit", "permanent": true },
    { "source": "/store-public", "destination": "/toolkit", "permanent": true },
    { "source": "/maritime-toolkit", "destination": "/toolkit", "permanent": true },
    { "source": "/maritime-toolkit/", "destination": "/toolkit", "permanent": true },
    { "source": "/impa", "destination": "/toolkit", "permanent": true },
    { "source": "/impa/", "destination": "/toolkit", "permanent": true },
    { "source": "/maritime-pms", "destination": "/sm", "permanent": true },
    { "source": "/maritime-pms/", "destination": "/sm", "permanent": true },
    { "source": "/ship-repair-korea", "destination": "/services#ship-repair-korea", "permanent": true },
    { "source": "/ship-repair-korea/", "destination": "/services#ship-repair-korea", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/rfq-draft", "destination": "/api/rfq" },
    { "source": "/api/rfq-submit", "destination": "/api/rfq" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "app.thevesselcode.com" }],
      "destination": "/app.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "thevesselcode.com" }],
      "destination": "/home/index.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.thevesselcode.com" }],
      "destination": "/home/index.html"
    },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/ship-repair-chandler-korea", "destination": "/ship-repair-chandler-korea/index.html" },
    { "source": "/ship-chandler-korea", "destination": "/ship-repair-chandler-korea/index.html" },
    { "source": "/korea-ship-services", "destination": "/ship-repair-chandler-korea/index.html" },
    { "source": "/sm", "destination": "/sm/index.html" },
    { "source": "/contact-us", "destination": "/contact-us/index.html" },
    { "source": "/forum", "destination": "/forum/index.html" },
    { "source": "/insights", "destination": "/insights/index.html" },
    { "source": "/toolkit", "destination": "/toolkit.html" },
    { "source": "/store/:code", "destination": "/api/store/:code" },
    {
      "source": "/((?!vendor|js|css|icons|data|public|admin|downloads|bluehost|api|manifest.json|manifest-sm.json|sw.js|service-worker.js|package.json|app.html|toolkit.html|store-public.html|home|services|ship-repair-korea|ship-repair-chandler-korea|sm|contact-us|forum|insights|store|sitemap|robots\\.txt).+)",
      "has": [{ "type": "host", "value": "app.thevesselcode.com" }],
      "destination": "/app.html"
    }
  ],
  "functions": {
    "api/store/[code].js": {
      "includeFiles": "api/_data/impa-seo-index.json"
    },
    "api/billing/[...path].js": {
      "maxDuration": 30
    },
    "api/vessel-ais.js": {
      "includeFiles": "data/vessel-overrides.json"
    },
    "api/ask-brain.js": {
      "includeFiles": "data/tvc-knowledge-base.json"
    },
    "api/revenue-pipeline.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://thevesselcode.com https://www.thevesselcode.com https://*.thevesselcode.com"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/app.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/toolkit.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/services/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/ship-repair-korea/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/ship-repair-chandler-korea/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
