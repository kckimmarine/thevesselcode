# Gmail IMAP ingest (scripts/fetch-gmail-direct.mjs) — copy to `.env` and fill in.
# Never commit `.env` (gitignored).

GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword

# TVC Brain (api/ask-brain.js) — set the same keys in Vercel Production env.
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=optional-fallback

# Revenue pipeline (GSC + GA4 → weekly digest) — Vercel Production
# GA4_PROPERTY_ID=123456789
# GSC_SITE_URL=https://www.thevesselcode.com/
# GOOGLE_SERVICE_ACCOUNT_JSON=base64-or-raw-json
# REVENUE_PIPELINE_SECRET=long-random-string
# CRON_SECRET=long-random-string
# REVENUE_DIGEST_TO=ktechship@gmail.com
